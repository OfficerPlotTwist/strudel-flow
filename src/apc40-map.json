  "selection": {
    "mechanism": "channel-of-burst",
    "buttons": "8 track select + master select (9 total, the row directly below clip stop)",
    "sends_note": false,
    "note": "These 9 buttons transmit NO note message. Notes 51 and 80 were seed guesses and never appeared in a 1000-second capture. Pressing one makes the APC40 re-transmit its stored device-knob values as a burst of CC 16-23 on the newly selected track's channel. Detect the selected track by reading the channel of any incoming CC 16-23.",
    "observed_sweep_seconds": {
      "track1": 449.32,
      "track2": 449.57,
      "track3": 449.88,
      "track4": 450.19,
      "track5": 450.47,
      "track6": 450.78,
      "track7": 451.09,
      "track8": 451.41,
      "master": 452.83
    }
  },
  "leds": {
    "button_leds": "Overridden by local control in mode 0x40. Host note-on writes are accepted but the hardware relights from its own state. Full host control needs mode 0x41/0x42, which also stops the hardware lighting buttons at all.",
    "knob_rings": "Host CC writes to the ring DO work in mode 0x40 (verified by flashing the CC 48-55 bank). Ring style on CC 24-31 (device bank) and CC 56-63 (track control bank); position on the knob's own CC. Local movement overwrites a host-written ring value immediately - turning the knob down de-lights a ring the host had filled.",
    "ring_styles": {
      "0": "off",
      "1": "single",
      "2": "volume",
      "3": "pan"
    }
  },
  "faults": [
